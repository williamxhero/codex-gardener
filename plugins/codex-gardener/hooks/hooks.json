{
  "description": "Collect low-risk task signals and request one bounded knowledge review when useful.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/project_boundary.py\"",
            "commandWindows": "cmd.exe /d /c %PLUGIN_ROOT%\\scripts\\codex-gardener-hook.cmd project_boundary",
            "timeout": 3,
            "statusMessage": "Checking project ownership boundary"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/gardener.py\" hook SessionStart",
            "commandWindows": "cmd.exe /d /c %PLUGIN_ROOT%\\scripts\\codex-gardener-hook.cmd gardener SessionStart",
            "timeout": 3,
            "statusMessage": "Starting Codex Gardener"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/gardener.py\" hook UserPromptSubmit",
            "commandWindows": "cmd.exe /d /c %PLUGIN_ROOT%\\scripts\\codex-gardener-hook.cmd gardener UserPromptSubmit",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/gardener.py\" hook PostToolUse",
            "commandWindows": "cmd.exe /d /c %PLUGIN_ROOT%\\scripts\\codex-gardener-hook.cmd gardener PostToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/gardener.py\" hook Stop",
            "commandWindows": "cmd.exe /d /c %PLUGIN_ROOT%\\scripts\\codex-gardener-hook.cmd gardener Stop",
            "timeout": 5,
            "statusMessage": "Checking for reusable knowledge"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/gardener.py\" hook SessionEnd",
            "commandWindows": "cmd.exe /d /c %PLUGIN_ROOT%\\scripts\\codex-gardener-hook.cmd gardener SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
